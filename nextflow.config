/*
 * low-input-nanopore
 * Quantifying sample-DNA enrichment achieved by depletion-mode adaptive
 * sampling against a genomic carrier (default: lambda, with the E. coli
 * contaminant carried over from lambda production).
 */

manifest {
    name            = 'CarrCE/low-input-nanopore'
    author          = 'Jordan McKaig, Jenna Sailor, Christopher E. Carr'
    homePage        = 'https://github.com/CarrCE/low-input-nanopore'
    description     = 'Enrichment analysis for depletion-mode adaptive sampling nanopore sequencing'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
    defaultBranch   = 'main'
}

params {
    // ---- inputs -----------------------------------------------------------
    samplesheet     = null          // CSV; see assets/samplesheets/
    // Experimental DNA masses and the basis of each. Authoritative for every
    // sample it names; the samplesheets carry file paths and keys only.
    measurements    = "${projectDir}/assets/measurements.tsv"
    community       = null          // TSV of community members; per-samplesheet-row override
    outdir          = "${projectDir}/results"
    refdir          = "${projectDir}/refs"

    // ---- method -----------------------------------------------------------
    // competitive : one minimap2 pass against a combined index; best hit wins.
    // sequential  : carrier subtraction -> contaminant subtraction -> community.
    // both        : run competitive and sequential, emit a side-by-side delta.
    mode            = 'competitive'

    // Carrier and contaminant are parameterised so the tool generalises beyond
    // this study's lambda/E. coli case.
    carrier_accession     = 'GCF_000840245.1'   // Enterobacteria phage lambda NC_001416.1
    contaminant_accession = 'GCF_000005845.2'   // E. coli K-12 MG1655 (lambda-prep background)

    // Reference-guided consensus of the actual contaminant present in the
    // carrier prep (breseq). Off by default; the sequential mode of the
    // original S1 analysis used it.
    breseq_consensus      = false
    // Minimum contaminant depth before breseq is worth running. Below roughly
    // 10x breseq predicts missing coverage across the whole reference and
    // returns a deleted genome rather than a consensus. This study's replicates
    // reach 20-56x; the bundled test profile reaches ~0.2x, so -profile test
    // cannot exercise --breseq_consensus.
    breseq_min_depth      = 10

    // ---- filtering --------------------------------------------------------
    min_qscore      = 0             // 0 = keep all basecalled reads
    min_readlen     = 0
    min_mapq        = 0             // assignment uses primary alignments; see docs
    minimap2_preset = 'map-ont'

    // ---- outputs ----------------------------------------------------------
    keep_bams       = true
    coverage_window = 1000          // bp bin size for coverage-artifact profiles

    // ---- resources --------------------------------------------------------
    max_cpus        = 14
    max_memory      = '96.GB'
    max_time        = '96.h'

    // ---- future: raw data retrieval ---------------------------------------
    // The samplesheet reserves an `sra_accession` column. Once the FASTQs are
    // deposited, setting this true will fetch reads by accession instead of
    // reading local paths. Not yet implemented -- see docs/TODO.md.
    fetch_from_sra  = false

    help            = false
}

profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // Small, fast end-to-end run used for CI and for `make demo`.
    test {
        params.samplesheet = "${projectDir}/assets/samplesheets/test.csv"
        params.max_cpus    = 2
        params.max_memory  = '6.GB'
    }
}

includeConfig 'conf/base.config'

// ---- provenance ----------------------------------------------------------
def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }
