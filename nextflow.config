/*
 * low-input-nanopore
 * Quantifying sample-DNA enrichment achieved by depletion-mode adaptive
 * sampling against a genomic carrier (default: lambda, with the E. coli
 * contaminant carried over from lambda production).
 */

manifest {
    name            = 'CarrCE/low-input-nanopore'
    author          = 'Jordan McKaig, Jenna Sailor, Christopher E. Carr'
    homePage        = 'https://github.com/CarrCE/low-input-nanopore'
    description     = 'Enrichment analysis for depletion-mode adaptive sampling nanopore sequencing'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
    defaultBranch   = 'main'
}

params {
    // ---- inputs -----------------------------------------------------------
    samplesheet     = null          // CSV; see assets/samplesheets/
    // Experimental DNA masses and the basis of each. Authoritative for every
    // sample it names; the samplesheets carry file paths and keys only.
    measurements    = "${projectDir}/assets/measurements.tsv"
    community       = null          // TSV of community members; per-samplesheet-row override
    outdir          = "${projectDir}/results"
    refdir          = "${projectDir}/refs"

    // ---- method -----------------------------------------------------------
    // competitive : one minimap2 pass against a combined index; best hit wins.
    // sequential  : carrier subtraction -> contaminant subtraction -> community.
    // both        : run competitive and sequential, emit a side-by-side delta.
    mode            = 'competitive'

    // Carrier and contaminant are parameterised so the tool generalises beyond
    // this study's lambda/E. coli case.
    carrier_accession     = 'GCF_000840245.1'   // Enterobacteria phage lambda NC_001416.1
    contaminant_accession = 'GCF_000005845.2'   // E. coli K-12 MG1655 (lambda-prep background)

    // Reference-guided consensus of the actual contaminant present in the
    // carrier prep (breseq). Off by default; the sequential mode of the
    // original S1 analysis used it.
    breseq_consensus      = false
    // Minimum contaminant depth before breseq is worth running. Below roughly
    // 10x breseq predicts missing coverage across the whole reference and
    // returns a deleted genome rather than a consensus. This study's replicates
    // reach 20-56x; the bundled test profile reaches ~0.2x, so -profile test
    // cannot exercise --breseq_consensus.
    breseq_min_depth      = 10

    // ---- human read masking -----------------------------------------------
    // Off by default, so every run without it is bit-identical to before.
    //
    // NOTE for anyone editing this: mask_human must NOT be threaded into the
    // `meta` map. `meta` is part of MAP_COMPETITIVE's task hash, and putting a
    // downstream-only flag there would invalidate the mapping cache for every
    // replicate. The DNA masses taught us this the expensive way.
    mask_human           = false
    // T2T-CHM13v2.0. Screened reads are mapped against this SEPARATELY; it is
    // deliberately NOT a row in assets/references/, because those rows are
    // concatenated into the combined index and a 3.1 Gbp human genome there
    // would slow every mapping task while changing no assignment.
    human_accession      = 'GCF_009914755.1'
    human_index          = null      // prebuilt .mmi; built into refdir if null
    // A read is called chimeric when the human-aligned query interval that no
    // target organism accounts for reaches this length. Whole-read best-hit
    // assignment structurally cannot catch these: the read wins its comparison
    // on the microbial half and the human half rides along.
    chimera_min_bp       = 150

    // ---- filtering --------------------------------------------------------
    // Attribution floor: the fraction of a read an organism must align before
    // the read may be attributed to it. Reads below it are unassigned with
    // call=low_coverage. This exists because a read is credited to its winner
    // with its FULL length, so without a floor an organism that explains a few
    // hundred bases of a 70 kb read carries all 70 kb. Chosen from this
    // study's own coverage distribution -- see bin/attribution_threshold.py;
    // every value between 0.01 and 0.30 removes the same reads.
    min_aln_frac    = 0.10

    min_qscore      = 0             // 0 = keep all basecalled reads
    min_readlen     = 0
    min_mapq        = 0             // assignment uses primary alignments; see docs
    minimap2_preset = 'map-ont'

    // ---- outputs ----------------------------------------------------------
    keep_bams       = true
    coverage_window = 1000          // bp bin size for coverage-artifact profiles

    // ---- resources --------------------------------------------------------
    max_cpus        = 14
    max_memory      = '96.GB'
    max_time        = '96.h'

    // ---- raw data retrieval ------------------------------------------------
    // Fetch each sample's reads from the public archive by accession instead of
    // reading the samplesheet's local `fastq` column. Off by default: the lab
    // runs from local files, and a default that reaches the network would make
    // every run depend on ENA being up.
    //
    // The reads are deposited under BioProject PRJNA1513130 and are NOT public
    // until the submission is released, so this currently fails with a message
    // saying so. Nothing needs to be edited when they are released -- the
    // samplesheets carry BioSample accessions and ENA resolves each to its run.
    fetch_from_sra  = false
    // Downloaded reads are cached here, outside outdir: they are inputs derived
    // from an accession, not results, and a `rm -rf results` must not throw away
    // 41 GB of download.
    sradir          = "${projectDir}/sra"
    // Overridden only by tests and by anyone pointing at a mirror.
    ena_portal      = 'https://www.ebi.ac.uk/ena/portal/api'

    help            = false
}

profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // Small, fast end-to-end run used for CI and for `make demo`.
    test {
        params.samplesheet = "${projectDir}/assets/samplesheets/test.csv"
        params.max_cpus    = 2
        // 6 GB covers every step of the smoke test EXCEPT --mask_human, whose
        // MAP_HUMAN loads a 7.55 GiB human index and is OOM-killed below ~10 GB.
        // This is a ceiling, not an allocation: the other test processes ask for
        // far less and are unaffected by raising it.
        params.max_memory  = '20.GB'
    }
}

includeConfig 'conf/base.config'

// ---- provenance ----------------------------------------------------------
def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }
