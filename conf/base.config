/*
 * Container pinning and per-process resources.
 *
 * Every container is pinned to an immutable DIGEST, not a tag: a tag can be
 * moved, and "0.40.1--h3be2455_0" or "3.12-slim-bookworm" resolving to
 * different bytes later would change the software that produced the published
 * numbers with nothing in the repository recording it. Nothing in this
 * pipeline runs on host-installed software, so a clone reproduces the
 * published numbers given the same inputs.
 */

process {
    // Nextflow's default is `bash -ue`, which does NOT set pipefail, so in a
    // pipeline like `minimap2 ... | samtools view -b -o out.bam` only samtools'
    // status is seen. A minimap2 killed mid-stream (OOM) leaves samtools reading
    // EOF at a record boundary: it exits 0, the BAM is valid and short, and
    // every downstream count is silently low. It also defeated the retry rule
    // below, which tests for OOM exit codes that were never propagated.
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [104,134,137,138,139,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 2
    memory = 6.GB
    time   = 4.h

    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = { check_max( 6 * task.attempt, 'cpus'   ) }
        memory = { check_max( 24.GB * task.attempt, 'memory' ) }
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = { check_max( params.max_cpus as int, 'cpus'   ) }
        memory = { check_max( 48.GB * task.attempt, 'memory' ) }
        time   = 48.h
    }

    // MAP_HUMAN loads the CHM13 map-ont index, which is 7.55 GiB on disk and
    // wants roughly 1.2x that resident. It is the only process whose memory is
    // set by a reference rather than by the read volume, so it gets an explicit
    // floor instead of inheriting a label: at the 6 GB the test profile
    // otherwise allows, minimap2 is OOM-killed with exit 137 and an empty log.
    // The read volume itself is trivial -- only HRRT-flagged reads are mapped.
    withName: MAP_HUMAN {
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }

    // ---- containers -------------------------------------------------------
    // `tools` bundles minimap2 + samtools + seqkit + NCBI datasets, built from
    // pinned source for both amd64 and arm64 (see docker/tools/Dockerfile and
    // docs/benchmarks.md). Build it with `make images`.
    withLabel: tools {
        container = 'low-input-nanopore/tools:0.1.0'
    }
    withLabel: analysis {
        container = 'low-input-nanopore/analysis:0.1.0'
    }
    // breseq stays on the upstream amd64 image: the arm64 conda build of its
    // bowtie2 dependency has a SIMD/SIGILL risk, and this step runs on a small
    // read subset where emulation cost is immaterial. It must run as root --
    // breseq fails under a mapped non-root user -- so the global
    // docker.runOptions user mapping is overridden here.
    withLabel: breseq {
        container         = 'quay.io/biocontainers/breseq:0.40.1--h3be2455_0@sha256:9ab57f9225a8a39bcd120121bed51616a54d92fe74659c62912638527428a97b'
        containerOptions  = '--platform linux/amd64 -e HOME=/tmp'
    }
    // NCBI's HRRT 2.2.1, layered only to add `ps` (see docker/scrubber/
    // Dockerfile). The upstream image is pinned there BY DIGEST, so the tool
    // and its 1.02 GB k-mer database are pinned together; nothing in our layer
    // affects a masking decision.
    //
    // The upstream image cannot be used directly: it ships no procps, and
    // Nextflow's task wrapper runs `ps` under `bash -euo pipefail`, so every
    // task died with exit 1 and no output at all before the script even ran.
    //
    // amd64 only; there is no arm64 build, so this runs under Rosetta as
    // breseq does. HRRT was 760 s of a 954 s pass over a 17 GB read file.
    withLabel: scrubber {
        container         = 'low-input-nanopore/scrubber:0.1.0'
        containerOptions  = '--platform linux/amd64 -e HOME=/tmp'
    }
}

// Clamp requests to what the host actually has, so the same code runs on a
// laptop and on a cluster without editing process directives.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def cap = params.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
    return obj
}
