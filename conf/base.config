/*
 * Container pinning and per-process resources.
 *
 * Every container is pinned to an immutable tag. Nothing in this pipeline runs
 * on host-installed software, so a clone reproduces the published numbers
 * given the same inputs.
 */

process {
    // Nextflow's default is `bash -ue`, which does NOT set pipefail, so in a
    // pipeline like `minimap2 ... | samtools view -b -o out.bam` only samtools'
    // status is seen. A minimap2 killed mid-stream (OOM) leaves samtools reading
    // EOF at a record boundary: it exits 0, the BAM is valid and short, and
    // every downstream count is silently low. It also defeated the retry rule
    // below, which tests for OOM exit codes that were never propagated.
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [104,134,137,138,139,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 2
    memory = 6.GB
    time   = 4.h

    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = { check_max( 6 * task.attempt, 'cpus'   ) }
        memory = { check_max( 24.GB * task.attempt, 'memory' ) }
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = { check_max( params.max_cpus as int, 'cpus'   ) }
        memory = { check_max( 48.GB * task.attempt, 'memory' ) }
        time   = 48.h
    }

    // ---- containers -------------------------------------------------------
    // `tools` bundles minimap2 + samtools + seqkit + NCBI datasets, built from
    // pinned source for both amd64 and arm64 (see docker/tools/Dockerfile and
    // docs/benchmarks.md). Build it with `make images`.
    withLabel: tools {
        container = 'low-input-nanopore/tools:0.1.0'
    }
    withLabel: analysis {
        container = 'low-input-nanopore/analysis:0.1.0'
    }
    // breseq stays on the upstream amd64 image: the arm64 conda build of its
    // bowtie2 dependency has a SIMD/SIGILL risk, and this step runs on a small
    // read subset where emulation cost is immaterial. It must run as root --
    // breseq fails under a mapped non-root user -- so the global
    // docker.runOptions user mapping is overridden here.
    withLabel: breseq {
        container         = 'quay.io/biocontainers/breseq:0.40.1--h3be2455_0'
        containerOptions  = '--platform linux/amd64 -e HOME=/tmp'
    }
}

// Clamp requests to what the host actually has, so the same code runs on a
// laptop and on a cluster without editing process directives.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def cap = params.max_memory as nextflow.util.MemoryUnit
            return obj.compareTo(cap) == 1 ? cap : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
    return obj
}
